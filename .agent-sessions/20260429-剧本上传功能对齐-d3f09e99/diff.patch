+function extractSnapshotBridgeScript(runtime: StudioRuntimeState): string {
+  const snapshot = runtime.currentProjectSnapshot;
+  if (!snapshot || snapshot.projectKind === "video") return "";
+
+  const priorityKinds = ["export", "episode", "reference", "plan"];
+  for (const kind of priorityKinds) {
+    const artifact = snapshot.artifacts.find(
+      (item) => item.kind === kind && item.content?.trim(),
+    );
+    if (artifact?.content?.trim()) {
+      return artifact.content.trim();
+    }
+  }
+
+  const fallbackArtifact = snapshot.artifacts.find((item) => item.content?.trim());
+  return fallbackArtifact?.content?.trim() || "";
+}
+
+function buildVideoBridgeInput(
+  runtime: StudioRuntimeState,
+  input: Record<string, unknown>,
+): Record<string, unknown> {
+  if (runtime.currentDramaProject) {
+    return input;
+  }
+
+  if (typeof input.script === "string" && input.script.trim()) {
+    return input;
+  }
+
+  const snapshotScript = extractSnapshotBridgeScript(runtime);
+  if (!snapshotScript) {
+    return input;
+  }
+
+  return {
+    ...input,
+    script: snapshotScript,
+  };
+}
