  "scripts": {
    "dev": "vite",
    "playwright-server": "node playwright-server.mjs",
    "dev:full": "concurrently \"npm run playwright-server\" \"npm run dev\"",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke:home-agent": "node scripts/home-agent-browser-smoke.mjs",
    "test:home-agent": "npm run smoke:home-agent && npx eslint scripts/home-agent-browser-smoke.mjs && npx vitest run src/components/home-agent/HomeAgentStudio.spec.tsx src/components/home-agent/ComposerChoicePopover.spec.tsx --reporter=dot",
    "repair:text-cache": "node scripts/repair-workspace-text-cache.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:sync-icon": "powershell -ExecutionPolicy Bypass -File scripts/sync-electron-icon.ps1",
    "electron:dev": "npm run electron:sync-icon && node electron/build.mjs && concurrently \"npm run dev\" \"node electron/dev-launch.cjs\"",
    "electron:build:dir": "npm run build && npm run electron:sync-icon && node electron/build.mjs && electron-builder --config electron-builder.yml --dir",
    "electron:build": "npm run build && npm run electron:sync-icon && node electron/build.mjs && electron-builder --config electron-builder.yml",
    "electron:preview": "npm run build && npm run electron:sync-icon && node electron/build.mjs && node electron/preview-launch.cjs"
